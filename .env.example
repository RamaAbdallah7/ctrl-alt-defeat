# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored -- never commit real tokens.
# ---------------------------------------------------------------------------

# Slack app credentials (Socket Mode -- see SLACK_SETUP.md)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# --- LLM providers -----------------------------------------------------------
# Primary. Without it the app still works for structured input (slash command
# with clear data, CSV upload); only free-text routing and the LLM-written
# executive brief fall back to a templated/offline mode.
ANTHROPIC_API_KEY=sk-ant-your-key

# Fallback provider, tried automatically if Anthropic errors or rate-limits
# during the demo. Optional -- leave blank to disable.
GEMINI_API_KEY=

# --- Optional overrides -----------------------------------------------------
# TARTEEB_MODEL=claude-sonnet-5
# TARTEEB_GEMINI_MODEL=gemini-2.5-flash
# TARTEEB_LLM_PROVIDERS=anthropic,gemini

# --- Microsoft Teams (see TEAMS_SETUP.md) -----------------------------------
# Only needed to run teams_app/app.py. Leave blank to use the Bot Framework
# Emulator, which needs no Azure registration.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=MultiTenant
MICROSOFT_APP_TENANT_ID=
